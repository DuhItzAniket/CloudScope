{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;RelWithDebInfo;Release",
        "CMAKE_DEFAULT_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CLOUDSCOPE_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows x64 (MSVC, vcpkg)",
      "description": "Run from a shell prepared by tools/build/win-env.bat. Needs VCPKG_ROOT and QT_ROOT_DIR.",
      "inherits": "base",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_HOST_TRIPLET": "x64-windows",
        "CMAKE_PREFIX_PATH": "$env{QT_ROOT_DIR}",
        "CLOUDSCOPE_EXPECT_ARCH": "x86_64"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "linux-x64",
      "displayName": "Linux x86-64 (GCC, Debian 13 packages)",
      "description": "Native build. Dependencies from tools/build/install-deps-debian.sh.",
      "inherits": "base",
      "cacheVariables": { "CLOUDSCOPE_EXPECT_ARCH": "x86_64" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "linux-aarch64",
      "displayName": "Linux arm64 (GCC, Raspberry Pi OS / Debian 13 packages)",
      "description": "Native build on a Raspberry Pi 5 or another arm64 machine. Dependencies from tools/build/install-deps-debian.sh.",
      "inherits": "base",
      "cacheVariables": { "CLOUDSCOPE_EXPECT_ARCH": "aarch64" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    }
  ],
  "buildPresets": [
    { "name": "windows-msvc", "configurePreset": "windows-msvc", "configuration": "Debug" },
    { "name": "linux-x64", "configurePreset": "linux-x64", "configuration": "Debug" },
    { "name": "linux-aarch64", "configurePreset": "linux-aarch64", "configuration": "Debug" }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "configuration": "Debug",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "timeout": 120 }
    },
    { "name": "windows-msvc", "inherits": "test-base", "configurePreset": "windows-msvc" },
    { "name": "linux-x64", "inherits": "test-base", "configurePreset": "linux-x64" },
    { "name": "linux-aarch64", "inherits": "test-base", "configurePreset": "linux-aarch64" }
  ]
}
