{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "cloudscope",
  "version-string": "0.2.0",
  "description": "CloudScope sky-observation system: C++ dependencies for Windows builds (Linux builds use Debian packages, see tools/build/install-deps-debian.sh).",
  "homepage": "https://github.com/DuhItzAniket/CloudScope",
  "license": "Apache-2.0",
  "builtin-baseline": "9e593bb18ea69cc5095e012465dcd675a822ed0d",
  "dependencies": [
    "cfitsio",
    "fmt",
    "libjpeg-turbo",
    "nlohmann-json",
    {
      "name": "opencv4",
      "default-features": false,
      "features": [
        "calib3d",
        "fs",
        "intrinsics",
        "jpeg",
        "png",
        "thread",
        "tiff"
      ]
    },
    "spdlog",
    "tl-expected",
    "tomlplusplus"
  ],
  "features": {
    "tests": {
      "description": "Unit-test dependencies",
      "dependencies": [
        "catch2"
      ]
    }
  }
}
