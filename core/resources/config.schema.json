{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DuhItzAniket/CloudScope/blob/master/core/resources/config.schema.json",
  "title": "CloudScope configuration (config.toml), format version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "logging",
    "camera",
    "simulation",
    "ai",
    "desktop"
  ],
  "properties": {
    "schema_version": {
      "description": "Version of the file format. CloudScope migrates older files automatically.",
      "type": "integer",
      "const": 1
    },
    "logging": {
      "description": "What is logged and where.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "console",
        "file",
        "directory",
        "max_file_mb",
        "max_files"
      ],
      "properties": {
        "level": {
          "description": "Messages below this level are dropped.",
          "enum": [
            "trace",
            "debug",
            "info",
            "warn",
            "error",
            "critical"
          ]
        },
        "console": {
          "description": "Write log lines to standard error.",
          "type": "boolean"
        },
        "file": {
          "description": "Write log lines to cloudscope.log in the log folder.",
          "type": "boolean"
        },
        "directory": {
          "description": "Log folder. Empty: the standard folder for this platform.",
          "type": "string"
        },
        "max_file_mb": {
          "description": "A log file is rotated when it would grow beyond this size.",
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "max_files": {
          "description": "Number of log files kept: the current one plus rotated ones.",
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "camera": {
      "description": "Real cameras.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uvc"
      ],
      "properties": {
        "uvc": {
          "description": "Offer the computer's USB video cameras and built-in webcams (UVC) as devices.",
          "type": "boolean"
        }
      }
    },
    "simulation": {
      "description": "Simulated devices for working and testing without hardware.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "seed",
        "replay_folder",
        "replay_fps"
      ],
      "properties": {
        "enabled": {
          "description": "Offer simulated devices next to real ones. Their data is always labelled as simulated.",
          "type": "boolean"
        },
        "seed": {
          "description": "The same seed gives the same clouds and the same sensor noise.",
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "replay_folder": {
          "description": "Folder of JPEG or PNG pictures shown by the replay camera in name order. Empty: no replay camera.",
          "type": "string"
        },
        "replay_fps": {
          "description": "Pictures per second of the replay camera.",
          "type": "number",
          "minimum": 0.01,
          "maximum": 120
        }
      }
    },
    "ai": {
      "description": "STRATIA inference (ADR-004).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "model_dir",
        "provider",
        "rate_hz",
        "threads"
      ],
      "properties": {
        "enabled": {
          "description": "Offer the ONNX Runtime engines as devices and run the model on live frames.",
          "type": "boolean"
        },
        "model_dir": {
          "description": "Folder with model_card.json and one .onnx file. Empty: no model.",
          "type": "string"
        },
        "provider": {
          "description": "Execution provider: auto (CUDA, then DirectML, then CPU), cuda, directml or cpu.",
          "enum": [
            "auto",
            "cuda",
            "directml",
            "cpu"
          ]
        },
        "rate_hz": {
          "description": "At most this many inferences per second; faster frames are dropped.",
          "type": "number",
          "minimum": 0.01,
          "maximum": 120
        },
        "threads": {
          "description": "Threads of the CPU provider; 0 for the runtime's default.",
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        }
      }
    },
    "desktop": {
      "description": "The desktop application.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "theme",
        "renderer",
        "session_root",
        "default_camera",
        "time_display",
        "temperature_unit",
        "calibration_file",
        "site",
        "pointing",
        "shortcuts"
      ],
      "properties": {
        "theme": {
          "description": "Dark theme, or the red night-vision theme.",
          "enum": [
            "dark",
            "night"
          ]
        },
        "renderer": {
          "description": "Live-view renderer: OpenGL when available (auto), OpenGL, or software.",
          "enum": [
            "auto",
            "opengl",
            "raster"
          ]
        },
        "session_root": {
          "description": "Folder for sessions and the frame catalogue. Empty: the Pictures folder.",
          "type": "string"
        },
        "default_camera": {
          "description": "Device id of the camera opened at start. Empty: none.",
          "type": "string"
        },
        "time_display": {
          "description": "How times are shown.",
          "enum": [
            "utc",
            "local",
            "both"
          ]
        },
        "temperature_unit": {
          "description": "Unit of temperature displays.",
          "enum": [
            "celsius",
            "fahrenheit"
          ]
        },
        "calibration_file": {
          "description": "Intrinsic calibration (cloudscope.camera_model/1) for the sky overlays. Empty: none.",
          "type": "string"
        },
        "site": {
          "description": "Where the camera stands.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "latitude_deg",
            "longitude_deg",
            "altitude_m"
          ],
          "properties": {
            "id": {
              "description": "Site identifier used in file names and sidecars.",
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "latitude_deg": {
              "description": "North positive.",
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitude_deg": {
              "description": "East positive.",
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "altitude_m": {
              "description": "Above sea level.",
              "type": "number",
              "minimum": -500,
              "maximum": 9000
            }
          }
        },
        "pointing": {
          "description": "Where the camera looks, as declared by the operator (until a mount or IMU reports it).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "azimuth_deg",
            "elevation_deg",
            "roll_deg"
          ],
          "properties": {
            "azimuth_deg": {
              "description": "From north through east.",
              "type": "number",
              "minimum": 0,
              "exclusiveMaximum": 360
            },
            "elevation_deg": {
              "description": "Above the horizon.",
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "roll_deg": {
              "description": "Turn about the optical axis.",
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          }
        },
        "shortcuts": {
          "description": "Keyboard shortcuts by action id, in Qt's spelling (\"Ctrl+Shift+F\"). Empty text removes one.",
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 64
          }
        }
      }
    }
  }
}
